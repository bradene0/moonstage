{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moonstage project manifest (moonstage.json)",
  "type": "object",
  "required": [
    "format",
    "name",
    "entryScene",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1,
      "description": "Project format version."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "entryScene": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "description": "Scene loaded first."
    },
    "scenes": {
      "type": "object",
      "description": "Scene id -> scene file path.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "description": "Path relative to the project root."
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Hex color: #rgb, #rrggbb or #rrggbbaa."
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tickRate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Fixed simulation ticks per second (default 60)."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Default random seed (default 1)."
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axes": {
          "type": "object",
          "description": "Axis name -> keys. Axis values range from -1 to 1.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "negative": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "positive": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "buttons": {
          "type": "object",
          "description": "Button name -> keys (KeyboardEvent.code values). Button values are 0 or 1.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Asset id -> asset declaration.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Path relative to the project root."
          },
          "type": {
            "type": "string",
            "description": "'image' (default for .png/.jpg/.jpeg/.gif/.webp/.svg), 'audio' (default for .ogg/.mp3/.wav/.m4a/.aac/.flac). Plugins may define other types."
          },
          "frame": {
            "type": "object",
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false,
            "description": "Sprite sheet layout: equal-size frames in rows, numbered left to right, top to bottom.",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "columns": {
                "type": "integer",
                "minimum": 1,
                "description": "Frames per row (default 1)."
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "description": "Number of frames (default columns)."
              }
            }
          },
          "pixelated": {
            "type": "boolean",
            "description": "Scale without smoothing (pixel art)."
          }
        }
      }
    },
    "behaviors": {
      "type": "object",
      "description": "Behavior module id -> module interface.",
      "additionalProperties": {
        "$ref": "#/$defs/behaviorModule"
      }
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "description": "World settings for the physics provider plugin.",
      "properties": {
        "gravity": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "description": "Pixels per second squared (default [0, 980])."
        }
      }
    },
    "prefabs": {
      "type": "object",
      "description": "Prefab name -> entity template that behaviors and plugins can spawn at runtime.",
      "additionalProperties": {
        "$ref": "#/$defs/prefab"
      }
    },
    "plugins": {
      "type": "object",
      "description": "Plugin name -> how to load and configure it.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "module"
        ],
        "additionalProperties": false,
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative path (./...) or package specifier."
          },
          "config": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "behaviorModule": {
      "title": "behavior module",
      "type": "object",
      "additionalProperties": false,
      "description": "A WebAssembly behavior and its interface. Slot indices used across the ABI follow the order of each list.",
      "properties": {
        "description": {
          "type": "string"
        },
        "language": {
          "enum": [
            "moonbit",
            "wasm"
          ],
          "description": "Default: 'moonbit' when `source` is set, else 'wasm'."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "MoonBit package directory, compiled by `moonstage build`."
        },
        "wasm": {
          "type": "string",
          "minLength": 1,
          "description": "Prebuilt WebAssembly module (any language)."
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Numeric parameters, read with param(slot)."
        },
        "state": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Numeric per-entity state, read/written with state_get/state_set(entity, slot)."
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Entity references, resolved with ref(slot)."
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Input axes/buttons, read with input(slot)."
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Events this module emits or receives."
        },
        "prefabs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Prefabs this module can spawn, with spawn(slot)."
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Scenes this module can switch to, with load_scene(slot)."
        },
        "sounds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Audio assets this module can play, with play_sound(slot, volume)."
        }
      }
    },
    "prefab": {
      "title": "prefab",
      "type": "object",
      "additionalProperties": false,
      "description": "An entity template. Spawned copies get generated ids (<prefab>-<n>) and start at the root.",
      "properties": {
        "name": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "components": {
          "$ref": "#/$defs/components"
        },
        "extensions": {
          "type": "object",
          "description": "Plugin-owned data keyed by plugin name. Validated by the plugin.",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "description": "Position in pixels (y down), rotation in radians (clockwise), scale. Relative to the parent.",
          "properties": {
            "position": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            },
            "rotation": {
              "type": "number"
            },
            "scale": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            }
          }
        },
        "shape": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "Basic vector renderable, centered on the entity origin.",
          "properties": {
            "kind": {
              "enum": [
                "rect",
                "circle",
                "polygon"
              ]
            },
            "size": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "rect: [width, height]"
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "description": "circle radius"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2,
                "description": "[x, y]"
              },
              "minItems": 3,
              "description": "polygon points, local space"
            },
            "fill": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "Hex color: #rgb, #rrggbb or #rrggbbaa."
            },
            "stroke": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "Hex color: #rgb, #rrggbb or #rrggbbaa."
            },
            "strokeWidth": {
              "type": "number",
              "minimum": 0
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "layer": {
              "type": "integer",
              "description": "Draw order; higher draws on top (default 0)."
            },
            "space": {
              "enum": [
                "world",
                "screen"
              ],
              "description": "'world' (default) is transformed by the camera; 'screen' is fixed to the viewport."
            }
          }
        },
        "text": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "description": "Text renderable. {entityId.stateName} placeholders are replaced with live state values.",
          "properties": {
            "value": {
              "type": "string"
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fill": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "Hex color: #rgb, #rrggbb or #rrggbbaa."
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "layer": {
              "type": "integer"
            },
            "space": {
              "enum": [
                "world",
                "screen"
              ],
              "description": "'world' (default) is transformed by the camera; 'screen' is fixed to the viewport."
            }
          }
        },
        "behavior": {
          "description": "One behavior, or a list of behaviors that run in order. Modules are declared in moonstage.json.",
          "anyOf": [
            {
              "$ref": "#/$defs/behaviorEntry"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/behaviorEntry"
              }
            }
          ]
        },
        "sprite": {
          "type": "object",
          "required": [
            "asset"
          ],
          "additionalProperties": false,
          "description": "Image renderable from an asset. Draws one frame of a sprite sheet, optionally animated.",
          "properties": {
            "asset": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Asset id declared in moonstage.json."
            },
            "size": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "Drawn size in pixels (default: frame size, or the image's natural size)."
            },
            "anchor": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "Point of the image placed at the entity origin, 0..1 (default [0.5, 0.5])."
            },
            "frame": {
              "type": "integer",
              "minimum": 0,
              "description": "Frame to draw (default 0)."
            },
            "frameState": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Use this entity state value as the frame; lets behaviors drive it."
            },
            "animation": {
              "type": "object",
              "required": [
                "fps"
              ],
              "additionalProperties": false,
              "description": "Play frames on simulation time, counted from when the entity was created.",
              "properties": {
                "fps": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "frames": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 1,
                  "description": "Default: every frame."
                },
                "loop": {
                  "type": "boolean",
                  "description": "Default true; false holds the last frame."
                }
              }
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "layer": {
              "type": "integer"
            },
            "space": {
              "enum": [
                "world",
                "screen"
              ],
              "description": "'world' (default) is transformed by the camera; 'screen' is fixed to the viewport."
            }
          }
        },
        "physicsBody": {
          "type": "object",
          "additionalProperties": false,
          "description": "Rigid body simulated by the project's physics provider plugin. Velocity is exchanged through state vx, vy, av.",
          "properties": {
            "type": {
              "enum": [
                "dynamic",
                "static",
                "kinematic"
              ],
              "description": "Default 'dynamic'."
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Default: derived from collider area and density."
            },
            "velocity": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "Initial velocity in pixels per second."
            },
            "angularVelocity": {
              "type": "number",
              "description": "Initial angular velocity in radians per second."
            },
            "gravityScale": {
              "type": "number",
              "description": "Default 1."
            },
            "linearDamping": {
              "type": "number",
              "minimum": 0
            },
            "angularDamping": {
              "type": "number",
              "minimum": 0
            },
            "fixedRotation": {
              "type": "boolean"
            }
          }
        },
        "collider": {
          "type": "object",
          "required": [
            "shape"
          ],
          "additionalProperties": false,
          "description": "Collision shape, centered on the entity origin plus offset. Without a physicsBody the collider is static.",
          "properties": {
            "shape": {
              "enum": [
                "circle",
                "box",
                "polygon"
              ]
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "size": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2,
                "description": "[x, y]"
              },
              "minItems": 3
            },
            "offset": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            },
            "density": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Default 1."
            },
            "friction": {
              "type": "number",
              "minimum": 0,
              "description": "Default 0.3."
            },
            "restitution": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Bounciness, default 0."
            },
            "sensor": {
              "type": "boolean",
              "description": "Reports overlaps without a physical response."
            }
          }
        },
        "joint": {
          "type": "object",
          "required": [
            "type",
            "target"
          ],
          "additionalProperties": false,
          "description": "Connects this entity's body to another entity's body.",
          "properties": {
            "type": {
              "enum": [
                "distance",
                "revolute",
                "weld"
              ]
            },
            "target": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Entity id of the other body."
            },
            "anchor": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "Local point on this body (default origin)."
            },
            "targetAnchor": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "Local point on the target body (default origin)."
            },
            "length": {
              "type": "number",
              "minimum": 0,
              "description": "distance: rest length (default: initial distance)."
            },
            "motorSpeed": {
              "type": "number",
              "description": "revolute: target angular speed in radians per second."
            },
            "maxMotorTorque": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "description": "The view is centered on this entity's world position.",
          "properties": {
            "zoom": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "behaviorEntry": {
      "title": "behavior",
      "type": "object",
      "required": [
        "module"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "refs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}
