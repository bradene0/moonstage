{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moonstage project manifest (moonstage.json)",
  "type": "object",
  "required": [
    "format",
    "name",
    "entryScene",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1,
      "description": "Project format version."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "entryScene": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "description": "Scene loaded first."
    },
    "scenes": {
      "type": "object",
      "description": "Scene id -> scene file path.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "description": "Path relative to the project root."
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
          "description": "Hex color: #rgb, #rrggbb or #rrggbbaa."
        }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tickRate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Fixed simulation ticks per second (default 60)."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Default random seed (default 1)."
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axes": {
          "type": "object",
          "description": "Axis name -> keys. Axis values range from -1 to 1.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "negative": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "positive": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "buttons": {
          "type": "object",
          "description": "Button name -> keys (KeyboardEvent.code values). Button values are 0 or 1.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Asset id -> asset declaration.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Path relative to the project root."
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "behaviors": {
      "type": "object",
      "description": "Behavior module id -> module interface.",
      "additionalProperties": {
        "$ref": "#/$defs/behaviorModule"
      }
    },
    "prefabs": {
      "type": "object",
      "description": "Prefab name -> entity template that behaviors and plugins can spawn at runtime.",
      "additionalProperties": {
        "$ref": "#/$defs/prefab"
      }
    },
    "plugins": {
      "type": "object",
      "description": "Plugin name -> how to load and configure it.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "module"
        ],
        "additionalProperties": false,
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1,
            "description": "Project-relative path (./...) or package specifier."
          },
          "config": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "behaviorModule": {
      "title": "behavior module",
      "type": "object",
      "additionalProperties": false,
      "description": "A WebAssembly behavior and its interface. Slot indices used across the ABI follow the order of each list.",
      "properties": {
        "description": {
          "type": "string"
        },
        "language": {
          "enum": [
            "moonbit",
            "wasm"
          ],
          "description": "Default: 'moonbit' when `source` is set, else 'wasm'."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "MoonBit package directory, compiled by `moonstage build`."
        },
        "wasm": {
          "type": "string",
          "minLength": 1,
          "description": "Prebuilt WebAssembly module (any language)."
        },
        "params": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Numeric parameters, read with param(slot)."
        },
        "state": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Numeric per-entity state, read/written with state_get/state_set(entity, slot)."
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Entity references, resolved with ref(slot)."
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Input axes/buttons, read with input(slot)."
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Events this module emits or receives."
        },
        "prefabs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "description": "Prefabs this module can spawn, with spawn(slot)."
        }
      }
    },
    "prefab": {
      "title": "prefab",
      "type": "object",
      "additionalProperties": false,
      "description": "An entity template. Spawned copies get generated ids (<prefab>-<n>) and start at the root.",
      "properties": {
        "name": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "components": {
          "$ref": "#/$defs/components"
        },
        "extensions": {
          "type": "object",
          "description": "Plugin-owned data keyed by plugin name. Validated by the plugin.",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "description": "Position in pixels (y down), rotation in radians (clockwise), scale. Relative to the parent.",
          "properties": {
            "position": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            },
            "rotation": {
              "type": "number"
            },
            "scale": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            }
          }
        },
        "shape": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "Basic vector renderable, centered on the entity origin.",
          "properties": {
            "kind": {
              "enum": [
                "rect",
                "circle",
                "polygon"
              ]
            },
            "size": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "rect: [width, height]"
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "description": "circle radius"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2,
                "description": "[x, y]"
              },
              "minItems": 3,
              "description": "polygon points, local space"
            },
            "fill": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "Hex color: #rgb, #rrggbb or #rrggbbaa."
            },
            "stroke": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "Hex color: #rgb, #rrggbb or #rrggbbaa."
            },
            "strokeWidth": {
              "type": "number",
              "minimum": 0
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "layer": {
              "type": "integer",
              "description": "Draw order; higher draws on top (default 0)."
            },
            "space": {
              "enum": [
                "world",
                "screen"
              ],
              "description": "'world' (default) is transformed by the camera; 'screen' is fixed to the viewport."
            }
          }
        },
        "text": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "description": "Text renderable. {entityId.stateName} placeholders are replaced with live state values.",
          "properties": {
            "value": {
              "type": "string"
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fill": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "Hex color: #rgb, #rrggbb or #rrggbbaa."
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "layer": {
              "type": "integer"
            },
            "space": {
              "enum": [
                "world",
                "screen"
              ],
              "description": "'world' (default) is transformed by the camera; 'screen' is fixed to the viewport."
            }
          }
        },
        "behavior": {
          "description": "One behavior, or a list of behaviors that run in order. Modules are declared in moonstage.json.",
          "anyOf": [
            {
              "$ref": "#/$defs/behaviorEntry"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/behaviorEntry"
              }
            }
          ]
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "description": "The view is centered on this entity's world position.",
          "properties": {
            "zoom": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "behaviorEntry": {
      "title": "behavior",
      "type": "object",
      "required": [
        "module"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "refs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}
