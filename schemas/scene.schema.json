{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moonstage scene (*.scene.json)",
  "type": "object",
  "required": [
    "format",
    "entities"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    },
    "camera": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "description": "Id of the entity whose camera component drives the view."
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "entity": {
      "title": "entity",
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean",
          "description": "Inactive entities are not updated or rendered (default true)."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          },
          "uniqueItems": true,
          "description": "Labels behaviors can query (count_tagged, nth_tagged, nearest_tagged). Spawned copies keep their prefab's tags."
        },
        "components": {
          "$ref": "#/$defs/components"
        },
        "extensions": {
          "type": "object",
          "description": "Plugin-owned data keyed by plugin name. Validated by the plugin.",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "description": "Position in pixels (y down), rotation in radians (clockwise), scale. Relative to the parent.",
          "properties": {
            "position": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            },
            "rotation": {
              "type": "number"
            },
            "scale": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            }
          }
        },
        "shape": {
          "type": "object",
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "description": "Basic vector renderable, centered on the entity origin.",
          "properties": {
            "kind": {
              "enum": [
                "rect",
                "circle",
                "polygon"
              ]
            },
            "size": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "rect: [width, height]"
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "description": "circle radius"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2,
                "description": "[x, y]"
              },
              "minItems": 3,
              "description": "polygon points, local space"
            },
            "fill": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "Hex color: #rgb, #rrggbb or #rrggbbaa."
            },
            "stroke": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "Hex color: #rgb, #rrggbb or #rrggbbaa."
            },
            "strokeWidth": {
              "type": "number",
              "minimum": 0
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "layer": {
              "type": "integer",
              "description": "Draw order; higher draws on top (default 0)."
            },
            "space": {
              "enum": [
                "world",
                "screen"
              ],
              "description": "'world' (default) is transformed by the camera; 'screen' is fixed to the viewport."
            }
          }
        },
        "text": {
          "type": "object",
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "description": "Text renderable. {entityId.stateName} placeholders are replaced with live state values.",
          "properties": {
            "value": {
              "type": "string"
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fill": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "Hex color: #rgb, #rrggbb or #rrggbbaa."
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "layer": {
              "type": "integer"
            },
            "space": {
              "enum": [
                "world",
                "screen"
              ],
              "description": "'world' (default) is transformed by the camera; 'screen' is fixed to the viewport."
            }
          }
        },
        "behavior": {
          "description": "One behavior, or a list of behaviors that run in order. Modules are declared in moonstage.json.",
          "anyOf": [
            {
              "$ref": "#/$defs/behaviorEntry"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/behaviorEntry"
              }
            }
          ]
        },
        "sprite": {
          "type": "object",
          "required": [
            "asset"
          ],
          "additionalProperties": false,
          "description": "Image renderable from an asset. Draws one frame of a sprite sheet, optionally animated.",
          "properties": {
            "asset": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Asset id declared in moonstage.json."
            },
            "size": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "Drawn size in pixels (default: frame size, or the image's natural size)."
            },
            "anchor": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "Point of the image placed at the entity origin, 0..1 (default [0.5, 0.5])."
            },
            "frame": {
              "type": "integer",
              "minimum": 0,
              "description": "Frame to draw (default 0)."
            },
            "frameState": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Use this entity state value as the frame; lets behaviors drive it."
            },
            "animation": {
              "type": "object",
              "required": [
                "fps"
              ],
              "additionalProperties": false,
              "description": "Play frames on simulation time, counted from when the entity was created.",
              "properties": {
                "fps": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "frames": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 1,
                  "description": "Default: every frame."
                },
                "loop": {
                  "type": "boolean",
                  "description": "Default true; false holds the last frame."
                },
                "offset": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "const": "auto"
                    }
                  ],
                  "description": "Start this many frames in, or 'auto' to derive a stable offset from the entity id so copies don't animate in sync."
                }
              }
            },
            "flipX": {
              "type": "boolean"
            },
            "flipY": {
              "type": "boolean"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "layer": {
              "type": "integer"
            },
            "space": {
              "enum": [
                "world",
                "screen"
              ],
              "description": "'world' (default) is transformed by the camera; 'screen' is fixed to the viewport."
            }
          }
        },
        "physicsBody": {
          "type": "object",
          "additionalProperties": false,
          "description": "Rigid body simulated by the project's physics provider plugin. Velocity is exchanged through state vx, vy, av.",
          "properties": {
            "type": {
              "enum": [
                "dynamic",
                "static",
                "kinematic"
              ],
              "description": "Default 'dynamic'."
            },
            "mass": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Default: derived from collider area and density."
            },
            "velocity": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "Initial velocity in pixels per second."
            },
            "angularVelocity": {
              "type": "number",
              "description": "Initial angular velocity in radians per second."
            },
            "gravityScale": {
              "type": "number",
              "description": "Default 1."
            },
            "linearDamping": {
              "type": "number",
              "minimum": 0
            },
            "angularDamping": {
              "type": "number",
              "minimum": 0
            },
            "fixedRotation": {
              "type": "boolean"
            }
          }
        },
        "collider": {
          "type": "object",
          "required": [
            "shape"
          ],
          "additionalProperties": false,
          "description": "Collision shape, centered on the entity origin plus offset. Without a physicsBody the collider is static.",
          "properties": {
            "shape": {
              "enum": [
                "circle",
                "box",
                "polygon"
              ]
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "size": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2,
                "description": "[x, y]"
              },
              "minItems": 3
            },
            "offset": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "[x, y]"
            },
            "density": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Default 1."
            },
            "friction": {
              "type": "number",
              "minimum": 0,
              "description": "Default 0.3."
            },
            "restitution": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Bounciness, default 0."
            },
            "sensor": {
              "type": "boolean",
              "description": "Reports overlaps without a physical response."
            }
          }
        },
        "joint": {
          "type": "object",
          "required": [
            "type",
            "target"
          ],
          "additionalProperties": false,
          "description": "Connects this entity's body to another entity's body.",
          "properties": {
            "type": {
              "enum": [
                "distance",
                "revolute",
                "weld"
              ]
            },
            "target": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Entity id of the other body."
            },
            "anchor": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "Local point on this body (default origin)."
            },
            "targetAnchor": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 2,
              "maxItems": 2,
              "description": "Local point on the target body (default origin)."
            },
            "length": {
              "type": "number",
              "minimum": 0,
              "description": "distance: rest length (default: initial distance)."
            },
            "motorSpeed": {
              "type": "number",
              "description": "revolute: target angular speed in radians per second."
            },
            "maxMotorTorque": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "description": "The view is centered on this entity's world position.",
          "properties": {
            "zoom": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "behaviorEntry": {
      "title": "behavior",
      "type": "object",
      "required": [
        "module"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "refs": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable identifier: a letter followed by letters, digits, '_' or '-'."
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  }
}
