          "size": [
            40,
            40
          ],
          "animation": {
            "fps": 8
          }
        }
      }
    },
    {
      "id": "ring",
      "components": {
        "transform": {
          "position": [
            240,
            400
          ]
        },
        "shape": {
          "kind": "polygon",
          "points": [
            [
              -30,
              0
            ],
            [
              0,
              -30
            ],
            [
              30,
              0
            ],
            [
              0,
              30
            ]
          ],
          "stroke": "#8f9bd9",
          "strokeWidth": 2
        }
      },
      "extensions": {
        "spin": {
          "speed": 1
        }
      }
