{
  "$schema": "../../../schemas/test.schema.json",
  "format": 1,
  "name": "touching a crystal scores a point, bursts into sparkles, shakes the camera and respawns the crystal",
  "scene": "main",
  "ticks": 2,
  "setup": [
    {
      "operation": "set_property",
      "target": "crystal-1",
      "property": "transform.position",
      "value": [
        800,
        905
      ]
    }
  ],
  "expect": [
    {
      "event": "collected",
      "count": {
        "equals": 1
      }
    },
    {
      "prefab": "sparkle",
      "count": {
        "equals": 8
      }
    },
    {
      "target": "score",
      "property": "state.points",
      "equals": 1
    },
    {
      "target": "camera",
      "property": "state.shake",
      "gt": 0.9
    },
    {
      "target": "crystal-1",
      "property": "transform.position.y",
      "lte": 1000
    },
    {
      "sound": "chime",
      "count": {
        "equals": 1
      }
    }
  ]
}
