{
  "name": "@moonstage/core",
  "version": "0.3.0",
  "description": "Moonstage core runtime: project model, validation, scenes, entities, behaviors (WebAssembly), plugins. No DOM, no Node, no dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradene0/moonstage.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bradene0/moonstage#readme",
  "bugs": {
    "url": "https://github.com/bradene0/moonstage/issues"
  },
  "keywords": [
    "moonstage",
    "game-engine",
    "webassembly",
    "moonbit",
    "interactive"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
